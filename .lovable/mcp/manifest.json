        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "full_name": {
              "description": "Nome completo",
              "type": "string"
            },
            "bio": {
              "description": "Descrição do perfil",
              "type": "string"
            },
            "category": {
              "description": "Categoria de serviço",
              "type": "string"
            },
            "city": {
              "description": "Cidade",
              "type": "string"
            },
            "phone": {
